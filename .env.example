# Backend API root, including the /api/v1 suffix.
# Optional — src/lib/config.ts falls back to the production host when unset.
NEXT_PUBLIC_API_BASE_URL=https://smart-duka-backend-iota.vercel.app/api/v1

# Absolute origin of this web app, no trailing slash. Used for canonical URLs,
# sitemap entries and Open Graph tags. Optional — src/lib/site.ts falls back to
# Vercel's VERCEL_PROJECT_PRODUCTION_URL, then to the production deployment.
NEXT_PUBLIC_SITE_URL=https://www.duqana.co.ke

# Google Search Console: HTML-tag verification content value only, not the
# full meta tag. Optional; leave empty until Google supplies your own token.
# Set for Production in Vercel and redeploy before selecting Verify in Google.
# Multiple existing owner tokens may be separated by commas.
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile site key for the /contact form's bot check. Public by
# design (it's sent to the browser). Pair with TURNSTILE_SECRET_KEY on the
# backend, from the same Turnstile widget in the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
